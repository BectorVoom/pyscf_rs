Cargo.lock.local
.cargo/config.toml.local
# Cargo's standard multi-binary layout uses `src/bin/` directories. The
# upstream Python `bin/` ignore (line 13) accidentally swallows them; un-ignore
# the xtask bins explicitly so Plan 01-05 lint binaries are committed.
!xtask/src/bin/
!xtask/src/bin/**

# Phase 3 BIND-01 — maturin develop emits the cdylib into the overlay.
# Source: .planning/phases/03-scf-pyo3-bindings/03-RESEARCH.md §"Runtime State Inventory" line 1058.
python/pyscf/_native*
python/pyscf/**/*.so
python/pyscf/**/*.dylib
python/pyscf/**/*.pyd

# Local Python / tooling environments (never committed)
.venv/
.upstream-venv/
.serena/

# Local agent state (Claude/GSD): isolated git worktrees + per-repo memory
.claude/worktrees/
.claude/memory/

# Scratch translation drafts
/translation*.txt
*_translation*.txt

